# principia.ndelucien.com — built to static files, served by nginx.
#
# Two stages so the shipped image has no Node in it: the runtime is nginx plus
# a few hundred kilobytes of HTML, fonts and screenshots. The build context is
# the REPOSITORY ROOT (the changelog, licence and documentation pages read the
# repository's own Markdown; src/lib/docs.ts lists which files), so paths
# below are prefixed with landing/.

FROM node:22-alpine AS build
WORKDIR /repo/landing
COPY landing/package.json landing/package-lock.json ./
RUN npm ci --no-audit --no-fund
COPY README.md CHANGELOG.md LICENSE DESIGN.md CONTRIBUTING.md SECURITY.md CODE_OF_CONDUCT.md /repo/
COPY docs/*.md /repo/docs/
COPY landing/ ./
# The build asks GitHub for the latest release; a cached layer would keep
# naming the release it saw last time, so every run gets its own stamp.
ARG BUILD_STAMP=dev
# The runner's token, for the release lookup; only the build stage sees it.
ARG GITHUB_TOKEN=
RUN echo "build $BUILD_STAMP" && GITHUB_TOKEN="$GITHUB_TOKEN" npm run build

FROM nginx:alpine
COPY --from=build /repo/landing/dist /usr/share/nginx/html
COPY landing/docker/nginx-site.conf /etc/nginx/conf.d/default.conf
EXPOSE 9940
HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
  CMD wget -qO- http://127.0.0.1:9940/ >/dev/null || exit 1
