---
import type { Section } from "../lib/schema";
type Steps = Extract<Section, { kind: "steps" }>;
const { s } = Astro.props as { s: Steps };
---
<section class="section" id={s.key} aria-labelledby={`${s.key}-title`}>
  <div class="frame">
    <div class="section-head"><span class="eyebrow">{s.kicker}</span><h2 id={`${s.key}-title`}>{s.title}</h2>{s.lede && <p>{s.lede}</p>}</div>
    <ol class="steps">
      {s.items.map((it, i) => (
        <li class="node step">
          <span class="no mono">{String(i + 1).padStart(2, "0")}</span>
          <h3>{it.title}</h3>
          <p>{it.body}</p>
        </li>
      ))}
    </ol>
  </div>
</section>
<style>
  .steps { display: grid; grid-template-columns: repeat(5, minmax(0, 1fr)); gap: 10px; margin: 0; padding: 0; list-style: none; counter-reset: step; }
  .step { position: relative; display: flex; flex-direction: column; gap: 8px; padding: 18px 16px 18px; }
  .step::after { content: ""; position: absolute; top: 28px; right: -10px; width: 10px; border-top: 1.5px dashed var(--violet); opacity: 0.8; }
  .step:last-child::after { display: none; }
  .no { display: grid; place-items: center; width: 26px; height: 26px; border-radius: 6px; background: var(--surface-2); color: var(--accent); font-size: 10px; }
  .step h3 { font-size: 17px; }
  .step p { font-size: 13.5px; line-height: 1.55; color: var(--muted); }
  @media (max-width: 960px) { .steps { grid-template-columns: repeat(2, minmax(0, 1fr)); } .step::after { display: none; } }
  @media (max-width: 520px) { .steps { grid-template-columns: 1fr; } }
</style>
