---
import Base from "../../layouts/Base.astro";
import { getSite } from "../../lib/content";
import { DOCS } from "../../lib/docs";
const site = getSite();
const description = "The documentation of Principia Desk, read from the repository at build time: installing, the ways out of a lock, your own classes, the runtime, storage, the teacher, the catalogue, contributing and security.";
const groups: { key: (typeof DOCS)[number]["group"]; title: string; lede: string }[] = [
  { key: "using", title: "Using the desk", lede: "What a learner needs: how to install it, how to get out of a lock, how to make a class of your own." },
  { key: "building", title: "How it is built", lede: "The contracts underneath: the runtime, the database, the teacher, the catalogue and the design system." },
  { key: "project", title: "The project", lede: "How to take part, and how to report what should not be public." },
];
---
<Base title={`Documentation · ${site.name}`} description={description} path="/docs">
  <section class="section">
    <div class="frame">
      <div class="section-head"><span class="eyebrow">Documentation</span><h1>Read it before you trust it.</h1><p>Every page here is a file in the repository, rendered at build time, so the words and the code are one commit. The <a href="/changelog">changelog</a> lives beside them.</p></div>
      {groups.map((g) => (
        <div class="group">
          <div class="group-head"><h2>{g.title}</h2><p>{g.lede}</p></div>
          <ul class="cards">
            {DOCS.filter((d) => d.group === g.key).map((d) => (
              <li class="node card">
                <a href={`/docs/${d.slug}`}>
                  <span class="mono path">{d.file}</span>
                  <strong>{d.title}</strong>
                  <p>{d.summary}</p>
                </a>
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>
  </section>
</Base>
<style>
  h1 { font-size: clamp(32px, 4.4vw, 48px); }
  .group { margin-bottom: 40px; }
  .group-head { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 2fr); gap: 20px; align-items: baseline; margin-bottom: 14px; padding-bottom: 10px; border-bottom: 1px solid var(--node-divider); }
  .group-head h2 { font-size: 20px; } .group-head p { color: var(--muted); font-size: 14px; }
  .cards { display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 300px), 1fr)); gap: 12px; margin: 0; padding: 0; list-style: none; }
  .card a { display: flex; flex-direction: column; gap: 8px; height: 100%; padding: 16px 18px 18px; color: inherit; text-decoration: none; }
  .card:hover { border-color: color-mix(in srgb, var(--accent) 45%, var(--node-border)); }
  .path { font-size: 10px; letter-spacing: 0.6px; color: var(--faint); }
  .card strong { font-size: 17px; font-weight: 500; color: var(--fg); }
  .card p { font-size: 14px; line-height: 1.55; color: var(--muted); }
  @media (max-width: 720px) { .group-head { grid-template-columns: 1fr; gap: 6px; } }
</style>
