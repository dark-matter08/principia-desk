{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Principia Desk",
  "version": "0.2.9",
  "identifier": "com.darkmatter.principia-desk",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Principia Desk",
        "theme": "Dark",
        "width": 1100,
        "height": 760,
        "minWidth": 640,
        "minHeight": 540,
        "visible": false
      },
      {
        "label": "splashscreen",
        "title": "Principia Desk",
        "url": "/splashscreen.html",
        "theme": "Dark",
        "width": 520,
        "height": 340,
        "center": true,
        "resizable": false,
        "maximizable": false,
        "minimizable": false,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$APPDATA/audio/**"
        ]
      }
    },
    "macOSPrivateApi": true
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "../THIRD_PARTY_NOTICES.md": "THIRD_PARTY_NOTICES.md"
    },
    "shortDescription": "Understand deeply. Practice daily.",
    "longDescription": "Principia Desk is a study desk for learning subjects from their foundations: classes with personal starting points, lessons taught by your own AI tutor from verified primary sources, durable appointments, and enforcement you choose per class.",
    "publisher": "darkmatter",
    "copyright": "Copyright 2026 darkmatter",
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDI1NTAxNzE2ODY1OTlGNzEKUldSeG4xbUdGaGRRSmQ2NGNCQ3FCNVJOMDM2RFRrbkFDUUkwWjdhdTJ2S21NbVIxNGZzVnQ1blIK",
      "endpoints": [
        "https://github.com/dark-matter08/principia-desk/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
